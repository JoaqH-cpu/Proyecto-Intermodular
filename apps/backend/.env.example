# Copia este archivo a .env (no se sube al repo).

# PostgreSQL del docker-compose.yml de la raíz (pnpm db:up).
DATABASE_URL=postgres://clavapalos:clavapalos@localhost:5432/clavapalos

# Redis del docker-compose.yml. Medusa lo usará cuando se configuren sus módulos (T12).
REDIS_URL=redis://localhost:6379

# Orígenes que pueden llamar a cada API (separados por comas).
# Tienda en :3000, panel en :3001, admin de Medusa en :9000/app.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000

# Secretos de sesión. En local vale cualquier cadena; en producción, valores largos y aleatorios.
JWT_SECRET=cambia-esto-en-local
COOKIE_SECRET=cambia-esto-en-local
